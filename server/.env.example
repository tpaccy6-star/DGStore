PORT=3001
JWT_SECRET=replace-this-secret

# WhatsApp Order Notifications for Store Owner (CallMeBot - 100% Free)
# 1. Send WhatsApp message "I allow callmebot to send me messages" to +34 644 44 20 63
# 2. CallMeBot will reply with your personal API key
# 3. Enter your phone (with international code, e.g. +250 788 123 456) & API key below or in Admin App UI
WHATSAPP_OWNER_PHONE=+250788123456
WHATSAPP_API_KEY=your_callmebot_api_key

# (Optional) Custom WhatsApp Webhook URL (Twilio, UltraMsg, Zapier, etc.)
# WHATSAPP_WEBHOOK_URL=https://your-webhook-endpoint.com/api/notify

# (Optional) Telegram Notifications (if used)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
